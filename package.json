{
  "name": "yellow-garden",
  "private": true,
  "version": "0.19.1",
  "description": "Un jardín 3D interactivo de ZyXer Labs para web y Windows.",
  "author": "ZyXer Labs",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:pack": "npm run build && npm run desktop:runtime && electron-builder --win --x64 --dir --publish never",
    "desktop:dist": "npm run build && npm run desktop:runtime && electron-builder --win --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@threlte/core": "^8.0.0",
    "gsap": "^3.13.0",
    "svelte": "^5.0.0",
    "three": "^0.180.0",
    "xstate": "^5.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
